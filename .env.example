# ---- Database (required) ---------------------------------------------------
# PostgreSQL — any provider works: Neon, Supabase, RDS, or the db service that
# ships with docker-compose.yml (in that case the four POSTGRES_* keys below
# are what compose actually uses; DATABASE_URL is rewritten for you).
#
# On serverless hosts use the POOLED connection string, e.g. for Neon:
#   postgresql://user:pass@ep-name-pooler.region.aws.neon.tech/db?sslmode=require
# and append connection tuning:
#   &connection_limit=10&pgbouncer=true
#
# One-off commands (prisma db push, prisma db seed) should point DATABASE_URL
# at the DIRECT (non-pooled) string for the run, then switch back.
DATABASE_URL="postgresql://scheduler:scheduler@127.0.0.1:5432/scheduler?schema=public"

# ---- Docker deployment (used by docker-compose.yml, not by the app) --------
# Choose a strong POSTGRES_PASSWORD — it protects ./data/pg on the server.
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=
POSTGRES_DB=scheduler
# Where the app port is reachable. Leave unset (loopback) when a TLS reverse
# proxy runs on the same machine; set 0.0.0.0 only if exposing the app directly.
BIND_HOST=127.0.0.1

# ---- Auth (required) -------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-real-one-before-deploying"
# The public address people visit. On Vercel this can stay unset and the
# deployment URL is picked up automatically; set it once a custom domain.
NEXTAUTH_URL="http://localhost:3000"
# How long a signed-in session lasts (1-90 days).
NEXTAUTH_SESSION_DAYS=30

# ---- Reminder cron (recommended on serverless) -----------------------------
# Protects /api/notifications/run. Vercel cron sends GET with
# "Authorization: Bearer <CRON_SECRET>"; self-hosted cron can POST with
# "x-cron-secret: <CRON_SECRET>". With a persistent process (Docker) the
# built-in worker runs by itself and this is optional.
CRON_SECRET=

# ---- Email (optional — Gmail or any SMTP) ----------------------------------
# Env values win over the in-app Settings → Notifications form, which keeps
# the app password out of the database on managed hosts. For Gmail use an
# App Password (Google Account → Security → 2-Step Verification → App
# passwords), host smtp.gmail.com, port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Google sign-in + calendar sync (optional) ------------------------------
# Set both to grow a "Sign in with company Google account" button on the
# sign-in page and mirror bookings into each person's own "Praper
# Scheduler" calendar. Redirect URI to whitelist:
#   https://YOUR-DOMAIN/api/auth/callback/google
# Without these the app behaves exactly as before — password sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
